<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FMS.Mobile"
             xmlns:conv="clr-namespace:FMS.Mobile.Converters"
             x:Class="FMS.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
            <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
            <conv:NullToEmptyConverter x:Key="NullToEmptyConverter" />
            <conv:IsNonZeroConverter x:Key="IsNonZeroConverter" />
            <conv:OverdueColorConverter x:Key="OverdueColorConverter" />
            <conv:IsStartableConverter x:Key="IsStartableConverter" />
            <conv:IsCompletableConverter x:Key="IsCompletableConverter" />
            <conv:SyncStatusColorConverter x:Key="SyncStatusColorConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
