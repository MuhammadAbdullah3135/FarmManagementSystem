<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.AnimalDetailPage"
             x:DataType="vm:AnimalDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Info Card -->
            <Frame CornerRadius="12" Padding="16" BackgroundColor="White" BorderColor="LightGray">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding TagNumber}" FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding Name}" FontSize="16" TextColor="Gray"
                           IsVisible="{Binding Name, Converter={StaticResource IsNotNullConverter}}" />
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="Type" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding AnimalType}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Breed" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Breed}" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Sex" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Sex}" />
                        <Label Grid.Row="3" Grid.Column="0" Text="Status" FontAttributes="Bold" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Status}" />
                        <Label Grid.Row="4" Grid.Column="0" Text="Location" FontAttributes="Bold" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Location}" />
                        <Label Grid.Row="5" Grid.Column="0" Text="Weight" FontAttributes="Bold" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding LatestWeight, StringFormat='{0} kg'}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Add Photo -->
            <Button Text="📷 Add Photo" Command="{Binding AddPhotoCommand}"
                    BackgroundColor="#E3F2FD" TextColor="#1565C0" CornerRadius="8" HeightRequest="44" />

            <!-- Quick Actions -->
            <Label Text="Quick Actions" FontSize="18" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Text="⚖️ Weight"
                        Command="{Binding GoToWeightEntryCommand}"
                        BackgroundColor="#E8F5E9" TextColor="Black" CornerRadius="8" />
                <Button Grid.Row="0" Grid.Column="1" Text="🍽️ Feed"
                        Command="{Binding GoToFeedEntryCommand}"
                        BackgroundColor="#FFF3E0" TextColor="Black" CornerRadius="8" />
                <Button Grid.Row="1" Grid.Column="0" Text="🏥 Medical"
                        Command="{Binding GoToMedicalEntryCommand}"
                        BackgroundColor="#FFEBEE" TextColor="Black" CornerRadius="8" />
                <Button Grid.Row="1" Grid.Column="1" Text="💉 Vaccine"
                        Command="{Binding GoToVaccinationEntryCommand}"
                        BackgroundColor="#F3E5F5" TextColor="Black" CornerRadius="8" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
