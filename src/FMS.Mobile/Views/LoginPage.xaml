<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="🌾 FMS Mobile"
                   FontSize="32" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Primary}" />

            <Label Text="Farm Management System"
                   FontSize="16" HorizontalTextAlignment="Center"
                   TextColor="Gray" Margin="0,0,0,20" />

            <Label Text="Email" FontSize="14" />
            <Entry Placeholder="Enter your email"
                   Keyboard="Email"
                   Text="{Binding Email}" />

            <Label Text="Password" FontSize="14" />
            <Entry Placeholder="Enter your password"
                   IsPassword="True"
                   Text="{Binding Password}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

            <Button Text="Login"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontSize="18" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Create Account"
                    Command="{Binding GoToRegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                    BackgroundColor="#E8F5E9"
                    TextColor="#2E7D32"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontSize="15" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
