<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             xmlns:models="clr-namespace:FMS.Mobile.Models"
             x:Class="FMS.Mobile.Views.FeedEntryPage"
             x:DataType="vm:FeedEntryViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="Feed Type" FontSize="14" />
            <Picker Title="Select feed type"
                    ItemsSource="{Binding FeedTypes}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedFeedType}" />
            <Label Text="Quantity *" FontSize="14" />
            <Entry Keyboard="Numeric" Text="{Binding Quantity}" Placeholder="0.0" />
            <Label Text="Date &amp; Time" FontSize="14" />
            <DatePicker Date="{Binding FedAt}" />
            <Label Text="Notes" FontSize="14" />
            <Editor Text="{Binding Notes}" Placeholder="Optional" HeightRequest="60" />
            <Button Text="Save Feed Record" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" HeightRequest="50" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
