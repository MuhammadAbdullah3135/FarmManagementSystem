<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadDashboardCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="12" Padding="16">

                <!-- Offline Banner -->
                <Border BackgroundColor="#FFF3E0" Stroke="#FF9800" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="12,8"
                        IsVisible="{Binding IsOffline}">
                    <Label Text="📵 Offline — changes will be queued for sync" FontSize="13" TextColor="#E65100" />
                </Border>

                <!-- Queue Size Warning -->
                <Border BackgroundColor="#FFF3E0" Stroke="#FF9800" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="12,8"
                        IsVisible="{Binding ShowQueueWarning}">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                        <Label FontSize="13" TextColor="#E65100" VerticalOptions="Center">
                            <Label.Text>
                                <Binding Path="PendingSyncCount" StringFormat="{}{0} records queued — sync soon to avoid data loss" />
                            </Label.Text>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- Sync Status Bar -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label FontSize="12" TextColor="Gray">
                            <Label.Text>
                                <Binding Path="LastSyncText" />
                            </Label.Text>
                        </Label>

                        <!-- Live Sync Progress -->
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsSyncing}">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}"
                                               HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                            <Label FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="Center">
                                <Label.Text>
                                    <Binding Path="SyncProgressText" />
                                </Label.Text>
                            </Label>
                        </HorizontalStackLayout>

                        <!-- Failed Count + Retry -->
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasFailedRecords}">
                            <Label FontSize="12" TextColor="Red" VerticalOptions="Center">
                                <Label.Text>
                                    <Binding Path="FailedCount" StringFormat="{}{0} failed" />
                                </Label.Text>
                            </Label>
                            <Button Text="Retry" FontSize="11" HeightRequest="24" Padding="8,0"
                                    CornerRadius="4" BackgroundColor="#FFCDD2" TextColor="#C62828"
                                    Command="{Binding RetryFailedCommand}" />
                        </HorizontalStackLayout>

                        <!-- Sync Status Text -->
                        <Label FontSize="12" Text="{Binding SyncStatusText}"
                               TextColor="{Binding HasFailedRecords, Converter={StaticResource SyncStatusColorConverter}}"
                               IsVisible="{Binding SyncStatusText, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="⟳ Sync Now"
                            Command="{Binding SyncNowCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                            FontSize="12" HeightRequest="32" Padding="12,0"
                            CornerRadius="6" VerticalOptions="Center"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InvertBoolConverter}}" />
                </Grid>

                <!-- Sync Error Details (expandable) -->
                <Border IsVisible="{Binding ShowSyncErrors}" Stroke="#FFCDD2" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="12" BackgroundColor="#FFF5F5">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="⚠️ Sync Errors" FontSize="13" FontAttributes="Bold" TextColor="#C62828" />
                        <CollectionView ItemsSource="{Binding SyncErrors}" HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardViewModel+SyncErrorDetail">
                                    <Label Text="{Binding DisplayText}" FontSize="11" TextColor="#666"
                                           LineBreakMode="TailTruncation" MaxLines="2" Margin="0,2" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <!-- Summary Cards -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#E8F5E9" CornerRadius="12" Padding="16">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalAnimals}" FontSize="28" FontAttributes="Bold" />
                            <Label Text="Total Animals" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#FFF3E0" CornerRadius="12" Padding="16">
                        <VerticalStackLayout>
                            <Label Text="{Binding PregnantCount}" FontSize="28" FontAttributes="Bold" />
                            <Label Text="Pregnant" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#FFEBEE" CornerRadius="12" Padding="16">
                        <VerticalStackLayout>
                            <Label Text="{Binding SickCount}" FontSize="28" FontAttributes="Bold" TextColor="Red" />
                            <Label Text="Sick" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#FCE4EC" CornerRadius="12" Padding="16">
                        <VerticalStackLayout>
                            <Label Text="{Binding DueVaccinationCount}" FontSize="28" FontAttributes="Bold" TextColor="Red" />
                            <Label Text="Due Vaccinations" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" BackgroundColor="#FFF8E1" CornerRadius="12" Padding="16">
                        <VerticalStackLayout>
                            <Label Text="{Binding OverdueTasks}" FontSize="28" FontAttributes="Bold" />
                            <Label Text="Overdue Tasks" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" BackgroundColor="#F3E5F5" CornerRadius="12" Padding="16">
                        <VerticalStackLayout>
                            <Label Text="{Binding UpcomingBirths}" FontSize="28" FontAttributes="Bold" />
                            <Label Text="Upcoming Births" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Alerts -->
                <Label Text="Alerts" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
                <CollectionView ItemsSource="{Binding Alerts}" HeightRequest="200">
                    <CollectionView.EmptyView>
                        <Label Text="No alerts" HorizontalTextAlignment="Center" TextColor="Gray" Margin="0,20" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardViewModel+AlertItem">
                            <Frame Padding="12" Margin="0,4" CornerRadius="8" BorderColor="LightGray">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                    <Label Text="{Binding Message}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
