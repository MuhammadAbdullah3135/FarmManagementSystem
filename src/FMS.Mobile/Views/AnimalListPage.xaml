<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.AnimalListPage"
             x:DataType="vm:AnimalListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Sync Status Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,8,16,0">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label FontSize="11" TextColor="Gray">
                    <Label.Text>
                        <Binding Path="LastSyncText" />
                    </Label.Text>
                </Label>
                <HorizontalStackLayout Spacing="6" IsVisible="{Binding ShowQueueWarning}">
                    <Label Text="⚠️" FontSize="12" VerticalOptions="Center" />
                    <Label FontSize="12" TextColor="#E65100" VerticalOptions="Center">
                        <Label.Text>
                            <Binding Path="PendingSyncCount" StringFormat="{}{0} records queued — sync soon" />
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="⟳ Sync"
                    Command="{Binding SyncNowCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    FontSize="11" HeightRequest="28" Padding="8,0"
                    CornerRadius="6" VerticalOptions="Center" />
        </Grid>

        <!-- Offline Banner -->
        <Border Grid.Row="1" BackgroundColor="#FFF3E0" Stroke="#FF9800" StrokeThickness="1"
                StrokeShape="RoundRectangle 8" Padding="12,8" Margin="16,4"
                IsVisible="{Binding IsOffline}">
            <Label Text="📵 Offline — changes will be queued" FontSize="13" TextColor="#E65100" />
        </Border>

        <!-- Search -->
        <HorizontalStackLayout Grid.Row="2" Padding="16" Spacing="8">
            <SearchBar Placeholder="Search by tag or name..."
                       Text="{Binding SearchQuery}"
                       SearchCommand="{Binding SearchCommand}"
                       HorizontalOptions="FillAndExpand" />
            <Button Text="📷" Command="{Binding ScanTagCommand}"
                    WidthRequest="44" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="18" />
        </HorizontalStackLayout>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Animals}"
                            SelectionMode="None"
                            Margin="0,0,0,16">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnimalListViewModel+AnimalListItem">
                        <Frame Margin="8,4" Padding="14" CornerRadius="8" BorderColor="LightGray">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AnimalListViewModel}}, Path=GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding TagNumber}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Name, Converter={StaticResource NullToEmptyConverter}}"
                                           FontSize="13" TextColor="Gray" />
                                    <Label FontSize="12" TextColor="Gray">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                <Binding Path="AnimalTypeName" />
                                                <Binding Path="BreedName" />
                                                <Binding Path="StatusName" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding LatestWeightKg, StringFormat='{0} kg'}"
                                       FontSize="13" TextColor="Gray" VerticalOptions="Center"
                                       IsVisible="{Binding LatestWeightKg, Converter={StaticResource IsNotNullConverter}}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="+"
                    Command="{Binding GoToCreateCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White" FontSize="24"
                    WidthRequest="56" HeightRequest="56"
                    CornerRadius="28"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,16,16" />
        </Grid>

    </Grid>

</ContentPage>
