<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.AnimalCreatePage"
             x:DataType="vm:AnimalCreateViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="Tag Number *" FontSize="14" />
            <Entry Text="{Binding TagNumber}" Placeholder="e.g. COW-001" />

            <Label Text="Name" FontSize="14" />
            <Entry Text="{Binding Name}" Placeholder="Optional name" />

            <Label Text="Date of Birth" FontSize="14" />
            <DatePicker Date="{Binding DateOfBirth}" />

            <Label Text="Notes" FontSize="14" />
            <Editor Text="{Binding Notes}" Placeholder="Optional notes" HeightRequest="80" />

            <Button Text="Register Animal" Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    CornerRadius="8" HeightRequest="50" FontSize="16" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
