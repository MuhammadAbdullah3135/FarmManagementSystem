<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.TaskListPage"
             x:DataType="vm:TaskListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Activity Indicator -->
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <!-- Overdue Banner -->
        <Frame Grid.Row="1" IsVisible="{Binding OverdueCount}" BackgroundColor="#FFF3E0"
               Padding="12,8" Margin="8,4" CornerRadius="8" BorderColor="#FF9800">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="⚠️" FontSize="16" VerticalOptions="Center" />
                <Label FontSize="14" VerticalOptions="Center" TextColor="#E65100">
                    <Label.Text>
                        <Binding Path="OverdueCount" StringFormat="{}{0} overdue task(s) need attention" />
                    </Label.Text>
                </Label>
            </HorizontalStackLayout>
        </Frame>

        <!-- Filter Bar -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Padding="12,4" VerticalOptions="Start">
            <Label Text="Filter:" FontSize="13" VerticalOptions="Center" TextColor="Gray" />
            <CollectionView ItemsSource="{Binding StatusFilters}" SelectionMode="Single"
                            SelectionChangedCommand="{Binding FilterByStatusCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}"
                            HeightRequest="36">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="12,6" StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                            <Label Text="{Binding .}" FontSize="12" HorizontalTextAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </HorizontalStackLayout>

        <!-- Task List -->
        <RefreshView Grid.Row="2" Command="{Binding LoadTasksCommand}">
            <CollectionView ItemsSource="{Binding Tasks}" SelectionMode="None"
                            Margin="0,40,0,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="✅" FontSize="48" HorizontalTextAlignment="Center" />
                        <Label Text="No tasks assigned" HorizontalTextAlignment="Center"
                               TextColor="Gray" FontSize="16" />
                        <Label Text="Pull down to refresh" HorizontalTextAlignment="Center"
                               TextColor="Gray" FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskListViewModel+TaskItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Complete ✓"
                                               BackgroundColor="#4CAF50"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModel}}, Path=CompleteTaskCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="Cancel ✗"
                                               BackgroundColor="#F44336"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModel}}, Path=CancelTaskCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <Border Padding="14" Margin="8,4" StrokeShape="RoundRectangle 8"
                                    Stroke="LightGray" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                    <!-- Priority Indicator -->
                                    <BoxView Grid.Row="0" Grid.Column="0" WidthRequest="4" HeightRequest="40"
                                             Color="{Binding PriorityColor}" CornerRadius="2" />

                                    <!-- Title + Description -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="Gray"
                                               LineBreakMode="TailTruncation" MaxLines="1"
                                               IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>

                                    <!-- Status Badge -->
                                    <Border Grid.Row="0" Grid.Column="2" Padding="8,3"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{Binding StatusColor}" StrokeThickness="1">
                                        <Label Text="{Binding StatusName}" FontSize="11"
                                               TextColor="{Binding StatusColor}" FontAttributes="Bold" />
                                    </Border>

                                    <!-- Due Date + Animal -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="12" Margin="14,4,0,0">
                                        <Label FontSize="12" Text="{Binding DueDateText}" TextColor="{Binding IsOverdue, Converter={StaticResource OverdueColorConverter}}" />
                                        <Label Text="{Binding AnimalName}" FontSize="12" TextColor="Gray"
                                               IsVisible="{Binding AnimalName, Converter={StaticResource IsNotNullConverter}}" />
                                    </HorizontalStackLayout>

                                    <!-- Action Buttons (for Pending tasks: Start; for InProgress: Complete) -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="3" Spacing="8" Margin="14,6,0,0">
                                        <Button Text="▶ Start" FontSize="12" HeightRequest="32"
                                                Padding="12,0" CornerRadius="6"
                                                BackgroundColor="#2196F3" TextColor="White"
                                                IsVisible="{Binding StatusName, Converter={StaticResource IsStartableConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModel}}, Path=StartTaskCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="✓ Complete" FontSize="12" HeightRequest="32"
                                                Padding="12,0" CornerRadius="6"
                                                BackgroundColor="#4CAF50" TextColor="White"
                                                IsVisible="{Binding StatusName, Converter={StaticResource IsCompletableConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModel}}, Path=CompleteTaskCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="✗ Cancel" FontSize="12" HeightRequest="32"
                                                Padding="12,0" CornerRadius="6"
                                                BackgroundColor="#F44336" TextColor="White"
                                                IsVisible="{Binding StatusName, Converter={StaticResource IsCompletableConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModel}}, Path=CancelTaskCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
