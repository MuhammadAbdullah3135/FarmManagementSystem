<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="30" VerticalOptions="Center">

            <Label Text="Create Account"
                   FontSize="28" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Primary}" />

            <Label Text="First Name" FontSize="13" />
            <Entry Placeholder="First name" Text="{Binding FirstName}" />

            <Label Text="Last Name" FontSize="13" />
            <Entry Placeholder="Last name" Text="{Binding LastName}" />

            <Label Text="Account / Farm Name" FontSize="13" />
            <Entry Placeholder="e.g. Green Acres Farm" Text="{Binding AccountName}" />

            <Label Text="Email" FontSize="13" />
            <Entry Placeholder="Enter your email" Keyboard="Email" Text="{Binding Email}" />

            <Label Text="Password" FontSize="13" />
            <Entry Placeholder="At least 8 characters" IsPassword="True" Text="{Binding Password}" />

            <Label Text="Confirm Password" FontSize="13" />
            <Entry Placeholder="Re-enter password" IsPassword="True" Text="{Binding ConfirmPassword}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

            <Button Text="Create Account"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontSize="18" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Back to Login"
                    Command="{Binding BackToLoginCommand}"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
