<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.VaccinationEntryPage"
             x:DataType="vm:VaccinationEntryViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding AnimalTag, StringFormat='Animal: {0}'}"
                   FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                   IsVisible="{Binding AnimalTag, Converter={StaticResource IsNotNullConverter}}" />
            <Label Text="Vaccine Type *" FontSize="14" FontAttributes="Bold" />
            <Picker Title="Select vaccine"
                    ItemsSource="{Binding VaccineTypes}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedVaccineType}" />
            <Label Text="Date Given" FontSize="14" />
            <DatePicker Date="{Binding DateGiven}" />
            <Label Text="Vet Name" FontSize="14" />
            <Entry Text="{Binding VetName}" Placeholder="Veterinarian" />
            <Label Text="Batch Number" FontSize="14" />
            <Entry Text="{Binding BatchNumber}" Placeholder="Batch # (optional)" />
            <Label Text="Cost" FontSize="14" />
            <Entry Keyboard="Numeric" Text="{Binding Cost}" Placeholder="0.00" />
            <Label Text="Notes" FontSize="14" />
            <Editor Text="{Binding Notes}" Placeholder="Optional" HeightRequest="60" />
            <Button Text="Save Vaccination" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" HeightRequest="50" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
