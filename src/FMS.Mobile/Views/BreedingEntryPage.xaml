<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FMS.Mobile.ViewModels"
             x:Class="FMS.Mobile.Views.BreedingEntryPage"
             x:DataType="vm:BreedingEntryViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Sire (Male) -->
            <Label Text="Sire (Male) *" FontSize="14" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker Grid.Column="0"
                        Title="Select sire"
                        ItemsSource="{Binding MaleAnimals}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SireId}">
                    <!-- Note: Picker SelectedItem binding for Guid? won't work directly.
                         User should type tag or use lookup button below. -->
                </Picker>
                <Button Grid.Column="1" Text="🔍 Lookup"
                        Command="{Binding LookupSireCommand}"
                        WidthRequest="90" CornerRadius="8"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" />
            </Grid>
            <Entry Text="{Binding SireTag}" Placeholder="Or type sire tag number..."
                   Keyboard="Text" />

            <!-- Dam (Female) -->
            <Label Text="Dam (Female) *" FontSize="14" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker Grid.Column="0"
                        Title="Select dam"
                        ItemsSource="{Binding FemaleAnimals}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding DamId}">
                </Picker>
                <Button Grid.Column="1" Text="🔍 Lookup"
                        Command="{Binding LookupDamCommand}"
                        WidthRequest="90" CornerRadius="8"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" />
            </Grid>
            <Entry Text="{Binding DamTag}" Placeholder="Or type dam tag number..."
                   Keyboard="Text" />

            <!-- Breeding Date -->
            <Label Text="Breeding Date" FontSize="14" />
            <DatePicker Date="{Binding BreedingDate}" />

            <!-- Method -->
            <Label Text="Method" FontSize="14" />
            <Picker Title="Select method"
                    ItemsSource="{Binding Methods}"
                    SelectedItem="{Binding SelectedMethod}" />

            <!-- Result (only on edit) -->
            <VerticalStackLayout IsVisible="{Binding ShowResult}" Spacing="4">
                <Label Text="Result" FontSize="14" />
                <Picker Title="Select result"
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedResult}" />
            </VerticalStackLayout>

            <!-- Vet Name -->
            <Label Text="Veterinarian" FontSize="14" />
            <Entry Text="{Binding VetName}" Placeholder="Vet name (optional)" />

            <!-- Notes -->
            <Label Text="Notes" FontSize="14" />
            <Editor Text="{Binding Notes}" Placeholder="Additional notes..."
                    HeightRequest="80" />

            <Button Text="Save Breeding Record"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White" CornerRadius="8" HeightRequest="50"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
