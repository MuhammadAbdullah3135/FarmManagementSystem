{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fms-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Jobs": {
    "Enabled": true,
    "MaxRetryAttempts": 3,
    "FeedingTaskGeneration": {
      "Enabled": true,
      "Cron": "5 0 * * *"
    },
    "HealthStatusRecalculation": {
      "Enabled": true,
      "Cron": "0 * * * *"
    },
    "NotificationDispatch": {
      "Enabled": true,
      "Cron": "*/15 * * * *"
    },
    "HealthSnapshot": {
      "StalenessMinutes": 120
    }
  },
  "Notifications": {
    "EmailMinSeverityOnByDefault": "Critical",
    "MaxAlertsPerEmail": 20
  },
  "AnimalImport": {
    "MaxRows": 5000,
    "MaxFileBytes": 10485760,
    "MaxReportedRows": 500,
    "SampleValidRows": 10
  },
  "Storage": {
    "Provider": "Local",
    "UploadsRoot": "uploads",
    "PresignedUrlTtlMinutes": 5,
    "S3": {
      "Bucket": "",
      "Region": "auto",
      "ServiceUrl": "",
      "ForcePathStyle": true,
      "AccessKeyId": "",
      "SecretAccessKey": ""
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=fms;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "FarmManagementSystem",
    "Audience": "FarmManagementSystem",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "",
    "FromName": "Farm Management System",
    "RequestTimeoutSeconds": 5,
    "MaxAttempts": 2,
    "RetryBaseDelaySeconds": 1,
    "MaxRetryAfterSeconds": 10,
    "SendGrid": {
      "ApiKey": "",
      "BaseUrl": "https://api.sendgrid.com"
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  }
}
