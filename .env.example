# Database
ConnectionStrings__DefaultConnection=Server=localhost;Database=FMS;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true

# JWT (change these in production!)
Jwt__SecretKey=YourSuperSecretKeyThatIsAtLeast32BytesLong!ChangeThisInProduction!
Jwt__Issuer=FMS
Jwt__Audience=FMS
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=30

# CORS
Cors__AllowedOrigins__0=https://yourdomain.com

# Storage
Storage__UploadsRoot=uploads
