# Local settings template.
#
#  1. Copy this file:   cp .env.example .env
#  2. Replace every REPLACE_ME / ChangeThis value with real settings.
#  3. NEVER commit your real .env — it is gitignored on purpose.
#
# ── docker-compose secrets ──────────────────────────────────────────────
# Used by docker-compose.yml variable substitution (compose reads .env
# automatically). The api container refuses to start when either is empty,
# and SQL Server refuses to start with an empty/short SA password.
#
# SQL Server SA password (db service) and the API's connection string password.
# SQL Server requires at least 8 characters; use a strong unique password.
DB_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD_MIN_8_CHARS

# JWT signing key for compose (mapped to Jwt__SecretKey). Long random value,
# e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=REPLACE_ME_LONG_RANDOM_JWT_SIGNING_KEY

# ── API app settings (when running the API locally outside compose) ────
# Database
ConnectionStrings__DefaultConnection=Server=localhost;Database=FMS;User=sa;Password=REPLACE_ME_STRONG_DB_PASSWORD_MIN_8_CHARS;TrustServerCertificate=true;MultipleActiveResultSets=true

# JWT (change these in production!)
Jwt__SecretKey=REPLACE_ME_LONG_RANDOM_JWT_SIGNING_KEY
Jwt__Issuer=FMS
Jwt__Audience=FMS
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=30

# CORS
Cors__AllowedOrigins__0=https://yourdomain.com

# Storage
Storage__UploadsRoot=uploads
