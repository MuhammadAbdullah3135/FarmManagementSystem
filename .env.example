# Local settings template.
#
#  1. Copy this file:   cp .env.example .env
#  2. Replace every REPLACE_ME / ChangeThis value with real settings.
#  3. NEVER commit your real .env — it is gitignored on purpose.
#
# ── docker-compose secrets ──────────────────────────────────────────────
# Used by docker-compose.yml variable substitution (compose reads .env
# automatically). The api container refuses to start when either is empty, and
# PostgreSQL refuses to initialise with an empty POSTGRES_PASSWORD.
#
# PostgreSQL password for the `db` service and for the API's connection string.
# Use a strong unique value. Avoid a semicolon: the password is interpolated
# into a connection string in which `;` separates keywords.
DB_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD

# JWT signing key for compose (mapped to Jwt__SecretKey). Long random value,
# e.g. `openssl rand -base64 48`. The API refuses to start outside Development
# on a missing, short, or placeholder key, so this must be a real secret.
JWT_SIGNING_KEY=REPLACE_ME_LONG_RANDOM_JWT_SIGNING_KEY

# ── API app settings (when running the API locally outside compose) ────
# Database (PostgreSQL — the API is Npgsql, so use Host/Username, not Server/User)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fms;Username=postgres;Password=REPLACE_ME_STRONG_DB_PASSWORD

# JWT (required in every environment except Development, where a committed
# DEV-ONLY key applies; generate with `openssl rand -base64 48`)
Jwt__SecretKey=REPLACE_ME_LONG_RANDOM_JWT_SIGNING_KEY
Jwt__Issuer=FMS
Jwt__Audience=FMS
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=30

# CORS
Cors__AllowedOrigins__0=https://yourdomain.com

# ── Storage ─────────────────────────────────────────────────────────────
# Provider: Local (default) or S3. 'Local' writes to Storage__UploadsRoot on the
# host's own disk. That disk is EPHEMERAL on Heroku — every uploaded file is lost
# on the next release or dyno cycle — so production must use S3.
Storage__Provider=Local
Storage__UploadsRoot=uploads

# Lifetime of issued download URLs. They are bearer tokens, so keep this short:
# whoever holds one can read that single object until it expires.
Storage__PresignedUrlTtlMinutes=5

# ── S3-compatible object storage (used when Storage__Provider=S3) ───────
# Cloudflare R2 is the recommended backend: it charges no egress (farm photos are
# read far more often than written) and speaks the S3 API, so these same settings
# work for AWS S3 or MinIO. Leave ServiceUrl empty to use real AWS S3.
Storage__S3__Bucket=REPLACE_ME_BUCKET_NAME
Storage__S3__Region=auto
Storage__S3__ServiceUrl=https://REPLACE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
Storage__S3__AccessKeyId=REPLACE_ME_R2_ACCESS_KEY_ID
Storage__S3__SecretAccessKey=REPLACE_ME_R2_SECRET_ACCESS_KEY
Storage__S3__ForcePathStyle=true

# ── Scheduled background jobs ───────────────────────────────────────────
# Hangfire stores its job tables in the same PostgreSQL database as the
# application (schema "hangfire"), created on startup after EF migrations.
# Set Jobs__Enabled=false to run the API with no scheduler in this process —
# useful for a second instance that should only serve HTTP.
Jobs__Enabled=true
Jobs__MaxRetryAttempts=3

# Cron expressions are evaluated in UTC.
# Feeding-task generation for the current day: 00:05 UTC.
Jobs__FeedingTaskGeneration__Enabled=true
Jobs__FeedingTaskGeneration__Cron=5 0 * * *

# Due/overdue vaccination and weight-check snapshot refresh: hourly.
Jobs__HealthStatusRecalculation__Enabled=true
Jobs__HealthStatusRecalculation__Cron=0 * * *

# A snapshot older than this is treated as stale and the dashboard falls back
# to a live calculation (freshness degrades, the counts never do).
Jobs__HealthSnapshot__StalenessMinutes=120

# Notification dispatch: reconciles each farm's notifications against its alert
# conditions, then emails a digest for anything newly raised. Quarter-hourly is
# the most frequent job, and the cheapest — it reuses the dashboard's alert
# computation rather than duplicating it.
Jobs__NotificationDispatch__Enabled=true
Jobs__NotificationDispatch__Cron=*/15 * * * *

# ── Notifications ───────────────────────────────────────────────────────
# Severity at or above which an alert type is emailed by default. Recipients can
# override this per alert type in the app. Critical-only is deliberate: emailing
# every warning is the fastest way to get the channel ignored.
Notifications__EmailMinSeverityOnByDefault=Critical

# Digest cap, so a farm with hundreds of overdue vaccines produces a readable
# message instead of a wall of text (the rest stay in the notification centre).
Notifications__MaxAlertsPerEmail=20

# ── Animal bulk import ──────────────────────────────────────────────────
# CSV and .xlsx are parsed server-side, so every client imports through one
# pipeline. The defaults suit a herd register; lower MaxRows to keep an import
# small, or raise MaxFileBytes for a very wide spreadsheet.
AnimalImport__MaxRows=5000
AnimalImport__MaxFileBytes=10485760

# How many problem rows one preview or commit response carries. This caps the
# response, not the number of problems found — the counts always cover the whole
# file, so a truncated list still reports the true total.
AnimalImport__MaxReportedRows=500
AnimalImport__SampleValidRows=10
